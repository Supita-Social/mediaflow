# Servidor
PORT=3000
HOST=0.0.0.0
# Defina como true quando estiver atrás de um proxy reverso (Nginx, Render, Railway, Fly…)
TRUST_PROXY=false

# Binários (deixe em branco para usar os do PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=
# Cookies no formato Netscape (opcional; ajuda quando o YouTube limita o IP do servidor)
YTDLP_COOKIES_FILE=
# Runtime JavaScript para os desafios do YouTube (node, deno, ...). Vazio = padrão do yt-dlp
YTDLP_JS_RUNTIMES=node
# Atualiza o yt-dlp (nightly) a cada inicialização do contêiner
YTDLP_AUTO_UPDATE=true

# Armazenamento temporário dos arquivos convertidos
WORK_DIR=./tmp
FILE_TTL_MINUTES=30

# Limites
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_SIZE=20
MAX_DURATION_SECONDS=10800
MAX_FILESIZE_MB=2048
ANALYZE_TIMEOUT_MS=45000
JOB_TIMEOUT_MS=1800000

# Limite de requisições por IP (janela em ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_ANALYZE=60
RATE_LIMIT_CONVERT=15

# Equivalência perceptiva do codec de origem em relação ao MP3
AUDIO_FACTOR_OPUS=1.5
AUDIO_FACTOR_AAC=1.25
